# Server
PORT=5000
FRONTEND_URL=http://localhost:3000

# Wajib diisi. Tanpa ini login/register akan gagal.
# Generate nilai acak yang kuat, contoh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Set ke 1 jika berjalan di belakang reverse proxy (nginx, traefik,
# load balancer, Railway/Render/Fly, dll). Dibutuhkan agar rate limit
# membaca IP asli dari X-Forwarded-For, bukan IP proxy.
# JANGAN diisi angka lain — nilai true membuat limit mudah dilewati.
TRUST_PROXY=0

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pandawa
DB_USER=pandawa
DB_PASSWORD=secret

# Object Storage (S3 Compatible)
S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
S3_REGION=ap-southeast-1
S3_BUCKET=pandawa-photos
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key

# true  = MinIO, Cloudflare R2, Backblaze B2, kebanyakan provider S3-compatible
# false = AWS S3 asli
S3_FORCE_PATH_STYLE=true

# Opsional: jika bucket public / di belakang CDN, isi base URL-nya
# (contoh: https://pub-xxxx.r2.dev atau https://cdn.domain.com)
# Jika kosong, API otomatis pakai presigned URL (bucket private)
S3_PUBLIC_URL=

# Masa berlaku presigned URL (detik), default 3600 = 1 jam
S3_PRESIGN_EXPIRES=3600

# Masa berlaku token download foto (detik), default 900 = 15 menit
DOWNLOAD_TOKEN_EXPIRES=900

# Batas ukuran file ZIP bulk upload (byte), default 5GB.
# ZIP ditulis ke disk sementara, bukan ke memory, jadi server tidak OOM.
# Pastikan ruang disk server minimal 2x nilai ini.
BULK_MAX_UPLOAD=5368709120

# Batas total ukuran isi ZIP bulk upload (byte), default 500MB
BULK_MAX_UNCOMPRESSED=524288000

# ======================================================
# URUTAN DEPLOY (deployment baru)
# ======================================================
#
# 1) Isi semua environment variable di atas.
# 2) Terapkan schema (buat semua tabel):
#
#      npm run migrate
#
#    Idempotent — aman dijalankan berulang kali. Jika 5 tabel sudah
#    ada, script berhenti tanpa mengubah apa pun.
#
# 3) Buat admin pertama:
#
#      npm run create-admin -- <username> <password>
#
#    Password minimal 8 karakter dan harus mengandung huruf + angka.
#
# 4) Login di /admin/login.
#
# ======================================================
# ADMIN SETUP (tidak dibaca runtime, hanya untuk operator)
# ======================================================
#
# Buat admin pertama pada deployment baru. Setelah ini, admin
# berikutnya bisa ditambah lewat UI di menu "Users":
#
#   npm run create-admin -- <username> <password>
#
# Kosongkan seluruh data konten (events, graduates, media, photos)
# beserta objek di storage, tanpa menyentuh akun admin:
#
#   npm run reset-data          # dry run
#   npm run reset-data -- --yes # eksekusi
